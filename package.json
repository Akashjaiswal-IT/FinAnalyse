{
  "name": "tempest",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo build",
    "dev": "dotenv -- turbo dev",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "vitest run --passWithNoTests",
    "seed": "dotenv -- tsx scripts/seed.ts",
    "backtest": "dotenv -- tsx scripts/backtest.ts",
    "eval": "dotenv -- tsx scripts/eval-queries.ts",
    "bench:ingest": "dotenv -- tsx scripts/ingest-bench.ts",
    "drills": "dotenv -- tsx scripts/drills.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2",
    "tsx": "^4.21.0",
    "vitest": "^5.0.3",
    "@types/node": "^22.15.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
