# Copy to .env (setup.sh does this and links it into every app and package).

# packages/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dev

# packages/services
REDIS_URL=redis://localhost:6379
PINECONE_API_KEY=
PINECONE_INDEX=tempest
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5
TIINGO_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
NOAA_USER_AGENT=tempest-codeutsav (team@example.com)
# Comma list of sources to force offline, for the robustness drills only.
DISABLE_SOURCES=

# apps/api
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
# When set, runs.create and system.ingestNow require the x-demo-token header.
DEMO_TOKEN=

# apps/worker
SCHEDULES_ENABLED=true

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
